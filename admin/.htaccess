# O ficheiro com as passwords (já cifradas) nunca deve ser acessível diretamente.
<Files "users.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Documentação (contém a password da primeira conta) — nunca acessível pelo browser.
<FilesMatch "\.(txt|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
