# Só os endpoints são chamados pelo browser/Stripe. As bibliotecas e a
# configuração (com as chaves secretas) nunca devem ser abertas diretamente.
<FilesMatch "^(lib|beds24|stripe|config|config\.example)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
